# Copy to .env and fill in. Never commit the real .env.
APP_ENV=development            # "production" enables strict checks at startup
SECRET_KEY=                    # python -c "import secrets; print(secrets.token_urlsafe(48))"
DATA_ENCRYPTION_KEY=           # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COOKIE_SECURE=false            # true behind HTTPS (required in production)
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=                  # comma-separated, only if the web client is served from another origin
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Upload scanning (optional): ClamAV daemon, e.g. clamav:3310 with `docker compose --profile scan up`
CLAMD_ADDRESS=

# Push notifications: "log" (development) or "http" (a push gateway holding FCM/APNs credentials)
PUSH_PROVIDER=log
PUSH_GATEWAY_URL=
PUSH_GATEWAY_KEY=

# SMS: "log" (development) or "http" (generic JSON SMS API)
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=UNIV
